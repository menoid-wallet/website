# Menoid API — the variables it reads. Copy to .env and fill in; on Vercel,
# set the same ones in Project Settings → Environment Variables (not PORT).

# local runs only (Vercel has no port to listen on)
PORT=5010

# MongoDB Atlas — the V1 indexer's database
V1M_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/
V1M_DB_NAME=menoid_v1mainnet

# relayer keys, with or without 0x — mainnets (Monad, Base) and testnets never share one
V1M_MAINNET_RELAYER_PRIVATE_KEY=
V1M_RELAYER_PRIVATE_KEY=

# Base Sepolia RPC (the public endpoint caps eth_getLogs ranges)
V1M_BASE_SEPOLIA_RPC_URL=

# UptimeRobot calls /api/v1m/catch-up?key=<this> every 5 minutes (any long random string)
V1M_CATCHUP_KEY=

# optional
# CORS_ORIGINS=https://a.example,https://b.example   more sites allowed to call the API
# V1M_CHAINS=monad,base                              run only these chains (default: all)
# V1M_ON_DEMAND=1                                    locally: no indexer loop, like Vercel
# V1M_SYNC_BUDGET_MS=20000  V1M_BACKGROUND_BUDGET_MS=240000  V1M_STALE_MS=15000  V1M_REQUEST_BUDGET_MS=8000
